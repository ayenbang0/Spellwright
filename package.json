{
  "name": "magicraft-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room web prototype of Magicraft's wand-programming roguelike (see PLAN.md)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:art": "python tools/gen_art.py && python tools/make_preview.py",
    "build:data": "tsx scripts/build-data.ts",
    "build": "npm run build:data && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "sim": "tsx scripts/sim-builds.ts",
    "pretest": "npm run build:data",
    "sim:spells": "tsx scripts/sim-spells.ts",
    "predev": "npm run build:data"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
